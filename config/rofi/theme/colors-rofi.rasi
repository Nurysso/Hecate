/* Rofi Colors - Generated from Hecate Theme */
/* Generated: 2026-02-16 13:11:22 */

* {
    /* Special colors */
    background:     #101116;
    foreground:     #9abdb8;
    cursor:         #9abdb8;

    /* Base16 color palette */
    color0:         #101116;
    color1:         #A03D3A;
    color2:         #DC392F;
    color3:         #E23C31;
    color4:         #E14235;
    color5:         #3E827C;
    color6:         #4D877A;
    color7:         #9abdb8;
    color8:         #6b8480;
    color9:         #A03D3A;
    color10:        #DC392F;
    color11:        #E23C31;
    color12:        #E14235;
    color13:        #3E827C;
    color14:        #4D877A;
    color15:        #9abdb8;

    /* Semantic aliases */
    bg:             @background;
    fg:             @foreground;
    bg-alt:         #A03D3A;
    bg-dim:         @color0;
    fg-dim:         #6b8480;
    fg-bright:      #9abdb8;

    accent:         @color4;
    accent-alt:     @color12;

    red:            @color1;
    green:          @color2;
    yellow:         @color3;
    blue:           @color4;
    magenta:        @color5;
    cyan:           @color6;

    red-bright:     @color9;
    green-bright:   @color10;
    yellow-bright:  @color11;
    blue-bright:    @color12;
    magenta-bright: @color13;
    cyan-bright:    @color14;
}
