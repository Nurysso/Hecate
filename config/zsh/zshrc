# ═══════════════════════════════════════════════════════════════
# ~/.config/zsh/zshrc — Plugins, completions, prompt, widgets
# Managed by hecate. Do not add personal config here.
# Personal config → ~/.zshrc
# Aliases, env, fzf and functions → ~/.config/shell (shared with bash and fish)
# ═══════════════════════════════════════════════════════════════

# ── Shared config (PATH, env, fzf, aliases, functions, thefuck) ─
source "${XDG_CONFIG_HOME:-$HOME/.config}/shell/common.sh"
export KEYTIMEOUT=1

# ── History ────────────────────────────────────────────────────
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt HIST_IGNORE_SPACE   # Don't save commands starting with space

# ── Options ────────────────────────────────────────────────────
setopt INTERACTIVE_COMMENTS   # Allow comments in interactive shell
setopt NO_BEEP                # Stop that annoying beep
setopt AUTO_CD                # cd by typing directory name
setopt AUTO_PUSHD             # Push dirs on cd
setopt PUSHD_IGNORE_DUPS
setopt GLOB_DOTS              # Include dotfiles in globs
unsetopt FLOW_CONTROL         # Free Ctrl+S for forward history search

# ── Zinit (Plugin Manager) ────────────────────────────────────
# Installs zinit if missing
if [[ ! -f "$HOME/.local/share/zinit/zinit.git/zinit.zsh" ]]; then
    print -P "%F{33}▓▒░ Installing Zinit…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33}▓▒░ Zinit installed.%f"
fi
source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"

# Completion definitions must be on fpath before compinit
zinit light zsh-users/zsh-completions

# ── Completions ────────────────────────────────────────────────
autoload -Uz compinit
# Full rebuild only when the dump is older than a day, otherwise use the cache
zcompdump_old=(${ZDOTDIR:-$HOME}/.zcompdump(N.mh+24))
if (( $#zcompdump_old )); then compinit; else compinit -C; fi
unset zcompdump_old

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' accept-exact-dirs true
zstyle ':completion:*' rehash true
zstyle ':completion:*:kill:*' command ps -e -o pid,%cpu,tty,cputime,cmd
zstyle ':completion:*:cd:*' ignore-parents parent pwd
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.zsh/cache"

# fzf-tab goes after compinit and before plugins that wrap widgets (autosuggestions, highlighting)
zinit light-mode for \
    Aloxaf/fzf-tab \
    zsh-users/zsh-history-substring-search \
    zsh-users/zsh-autosuggestions \
    z-shell/zsh-unique-id \
    momo-lab/zsh-abbrev-alias \
    zdharma-continuum/fast-syntax-highlighting

# ── Smart ls (plain ls in huge dirs, eza elsewhere) ────────────
function check_dir_size() {
    local filecount=$(command ls -1A 2>/dev/null | head -n 1001 | wc -l)
    export LARGE_DIR=$(( filecount > 1000 ))
}
autoload -U add-zsh-hook
add-zsh-hook chpwd check_dir_size
check_dir_size

unalias ls ll la 2>/dev/null
ls() {
    if [[ $LARGE_DIR -eq 1 ]]; then
        command ls --color=auto --group-directories-first "$@"
    else
        eza --icons --group-directories-first "$@"
    fi
}
ll() {
    if [[ $LARGE_DIR -eq 1 ]]; then
        command ls -lA --color=auto --group-directories-first "$@"
    else
        eza -la --icons --group-directories-first --git "$@"
    fi
}
alias la='ll'

# ── Key Bindings ───────────────────────────────────────────────
# Same in bash and fish:
#   Ctrl+R history · Ctrl+T files · Alt+C dirs   (fzf)
#   Ctrl+G cdf · Ctrl+E vf · Ctrl+F fh · Up/Down prefix history search
bindkey -e
source <(fzf --zsh)

# History
bindkey '^[[A' history-substring-search-up          # Up arrow
bindkey '^[OA' history-substring-search-up
bindkey '^[[B' history-substring-search-down        # Down arrow
bindkey '^[OB' history-substring-search-down
bindkey '^P' history-substring-search-up            # Ctrl+P
bindkey '^N' history-substring-search-down          # Ctrl+N
bindkey '^S' history-incremental-search-forward     # Ctrl+S

# Word navigation
bindkey '^[[1;5C' forward-word                      # Ctrl+Right
bindkey '^[[1;5D' backward-word                     # Ctrl+Left
bindkey '^[f' forward-word                          # Alt+F
bindkey '^[b' backward-word                         # Alt+B

# Line navigation
bindkey '^A' beginning-of-line                      # Ctrl+A
bindkey '^[[H' beginning-of-line                    # Home
bindkey '^[OH' beginning-of-line
bindkey '^[[F' end-of-line                          # End
bindkey '^[OF' end-of-line

# Delete
bindkey '^[[3~' delete-char                         # Delete
bindkey '^[[P' delete-char                          # Delete (kitty variant)
bindkey '^?' backward-delete-char                   # Backspace
bindkey '^H' backward-kill-word                     # Ctrl+Backspace
bindkey '^[^?' backward-kill-word                   # Alt+Backspace
bindkey '^[[3;5~' kill-word                         # Ctrl+Delete
bindkey '^[d' kill-word                             # Alt+D

# Editing
bindkey '^K' kill-line                              # Ctrl+K - delete to end
bindkey '^U' backward-kill-line                     # Ctrl+U - delete to start
bindkey '^W' backward-kill-word                     # Ctrl+W - delete previous word
bindkey '^Y' yank                                   # Ctrl+Y - paste deleted text
bindkey '^[v' yank                                  # Alt+V - paste deleted text
bindkey '^_' undo                                   # Ctrl+_ - undo
bindkey '^Z' undo                                   # Ctrl+Z - undo (like VS Code)
bindkey '^[.' insert-last-word                      # Alt+. - insert last argument
bindkey '^L' clear-screen                           # Ctrl+L
bindkey '^[l' clear-screen                          # Alt+L
bindkey '^[^I' autosuggest-accept                   # Alt+Tab - accept autosuggestion

# ── Widgets ────────────────────────────────────────────────────
# Run the shared fuzzy functions as widgets so nothing is typed into the line or history
cdf-widget() { cdf; zle reset-prompt }
vf-widget() { vf </dev/tty; zle reset-prompt }
fh-widget() { local cmd; cmd=$(fh_pick) && BUFFER=$cmd && zle accept-line; zle reset-prompt }
zle -N cdf-widget
zle -N vf-widget
zle -N fh-widget
bindkey '^G' cdf-widget                             # Ctrl+G - fuzzy cd
bindkey '^E' vf-widget                              # Ctrl+E - fuzzy file edit
bindkey '^F' fh-widget                              # Ctrl+F - fuzzy history

# Insert a fuzzy-picked file or directory at the cursor
find-file() {
    local file
    file=$(fd --type f --hidden --exclude .git | fzf --prompt="📁 Find file: " --height=40%)
    [[ -n "$file" ]] && LBUFFER="${LBUFFER}${(q)file}"
    zle reset-prompt
}
find-dir() {
    local dir
    dir=$(fd --type d --hidden --exclude .git . ~ | fzf --prompt="📂 Find directory: " --height=40%)
    [[ -n "$dir" ]] && LBUFFER="${LBUFFER}${(q)dir}"
    zle reset-prompt
}
zle -N find-file
zle -N find-dir
bindkey '^X^F' find-file                            # Ctrl+X Ctrl+F
bindkey '^[o' find-file                             # Alt+O
bindkey '^X^D' find-dir                             # Ctrl+X Ctrl+D
bindkey '^[O' find-dir                              # Alt+Shift+O

# Empty Enter lists the directory
magic_enter() {
    [[ -z $BUFFER ]] && echo && ls
    zle accept-line
}
zle -N magic_enter
bindkey '^M' magic_enter

# Toggle sudo on the current line / rerun the last command with sudo
prepend_sudo() {
    if [[ $BUFFER != "sudo "* ]]; then
        BUFFER="sudo $BUFFER"
        CURSOR=$(( CURSOR+5 ))
    else
        BUFFER="${BUFFER#sudo }"
        CURSOR=$(( CURSOR-5 ))
    fi
}
sudo_last() {
    local last_cmd=$(fc -ln -1)
    [[ $last_cmd != "sudo "* ]] && last_cmd="sudo $last_cmd"
    BUFFER=$last_cmd
    CURSOR=${#BUFFER}
}
zle -N prepend_sudo
zle -N sudo_last
bindkey '^[s' prepend_sudo                          # Alt+S
bindkey '^[S' sudo_last                             # Alt+Shift+S

# Insert date / datetime
insert_date() { LBUFFER="${LBUFFER}$(date '+%Y-%m-%d')" }
insert_datetime() { LBUFFER="${LBUFFER}$(date '+%Y-%m-%d %H:%M:%S')" }
zle -N insert_date
zle -N insert_datetime
bindkey '^[D' insert_date                           # Alt+Shift+D
bindkey '^[T' insert_datetime                       # Alt+Shift+T

# ── Prompt ─────────────────────────────────────────────────────
command -v starship >/dev/null && eval "$(starship init zsh)"
