# ═══════════════════════════════════════════════════════════════
# BASH Configuration with Starship and custom functions for quality of life
# Aliases, env and functions live in ~/.config/shell (shared with zsh and fish)
# ═══════════════════════════════════════════════════════════════

# Enable the subsequent settings only in interactive sessions
case $- in
  *i*) ;;
    *) return;;
esac

# ───────────────────────────────────────────────────────────────
# Shared config (PATH, env, fzf, aliases, functions, thefuck)
# ───────────────────────────────────────────────────────────────
source "${XDG_CONFIG_HOME:-$HOME/.config}/shell/common.sh"

# ───────────────────────────────────────────────────────────────
# History
# ───────────────────────────────────────────────────────────────
HISTFILE=~/.bash_history
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups   # Skip dups and commands starting with space
shopt -s histappend
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"  # Share history between sessions

# ───────────────────────────────────────────────────────────────
# Options & completion
# ───────────────────────────────────────────────────────────────
shopt -s checkwinsize  # Update LINES and COLUMNS after each command
shopt -s globstar      # Enable ** for recursive globbing
shopt -s cdspell       # Auto-correct minor spelling errors in cd
shopt -s autocd        # Type a directory name to cd into it (like zsh and fish)

if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
fi
bind 'set completion-ignore-case on'  # Case-insensitive completion
bind 'set show-all-if-ambiguous on'   # List matches on first Tab
bind 'set colored-stats on'           # Colorful completion

# ───────────────────────────────────────────────────────────────
# Key Bindings (same in zsh and fish)
#   Ctrl+R history · Ctrl+T files · Alt+C dirs   (fzf)
#   Ctrl+G cdf · Ctrl+E vf · Ctrl+F fh · Up/Down prefix history search
# ───────────────────────────────────────────────────────────────
command -v fzf >/dev/null && eval "$(fzf --bash)"

bind '"\e[A": history-search-backward'
bind '"\eOA": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\eOB": history-search-forward'
bind -x '"\C-g": cdf'
bind -x '"\C-e": vf'
# Ctrl+F puts the picked command on the line; Enter runs it
bind -x '"\C-f": READLINE_LINE=$(fh_pick); READLINE_POINT=${#READLINE_LINE}'

# ───────────────────────────────────────────────────────────────
# Prompt
# ───────────────────────────────────────────────────────────────
command -v starship >/dev/null && eval "$(starship init bash)"
