mkdir aesthetic-wallpapers
cd aesthetic-wallpapers
git init

# 2. Add the remote repository

git remote add origin https://github.com/D3Ext/aesthetic-wallpapers.git

# 3. Enable sparse-checkout

git sparse-checkout init --cone

# 4. Set the sparse-checkout to include only the 'images' folder

git sparse-checkout set --no-cone images

# 5. Pull the data (this will only download the 'images' folder)

git pull origin main
